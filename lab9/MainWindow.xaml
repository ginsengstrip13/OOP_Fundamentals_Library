<Window x:Class="lab9.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:lab9"
        mc:Ignorable="d"
        Title="Телефонная книга" Height="450" Width="650"
        MinHeight="380" MinWidth="560">
    <!--
        View в паттерне MVVM.
        XAML описывает только внешний вид окна и привязки к MainViewModel.
        В разметке нет обработчиков Click, потому что действия выполняются через ICommand.
    -->
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       Text="Имя:"/>
            <!--
                TwoWay Binding переносит введенное имя из TextBox в свойство Name во ViewModel.
                UpdateSourceTrigger=PropertyChanged обновляет ViewModel сразу при вводе символа.
            -->
            <TextBox Grid.Column="1"
                     Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       Text="Телефон:"/>
            <!--
                Поле телефона также связано со свойством Phone во ViewModel.
                Валидация выполняется в модели Contact и используется ViewModel для доступности AddCommand.
            -->
            <TextBox Grid.Column="1"
                     Text="{Binding Phone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        </Grid>

        <!--
            Кнопки вызывают команды ViewModel.
            AddCommand не получает параметр, DeleteCommand получает выбранный контакт.
        -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Добавить"
                    Width="110"
                    Margin="0,0,8,0"
                    Command="{Binding AddCommand}"/>
            <Button Content="Удалить"
                    Width="110"
                    Command="{Binding DeleteCommand}"
                    CommandParameter="{Binding SelectedContact}"/>
        </StackPanel>

        <!-- Текст связан со свойством ValidationMessage и показывает состояние проверки данных. -->
        <TextBlock Grid.Row="3"
                   Margin="0,0,0,8"
                   Foreground="DarkSlateGray"
                   Text="{Binding ValidationMessage}"
                   TextWrapping="Wrap"/>

        <!--
            DataGrid показывает ObservableCollection<Contact>.
            SelectedItem связан с SelectedContact, поэтому ViewModel знает, какой контакт выбран.
        -->
        <DataGrid Grid.Row="4"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  ItemsSource="{Binding Contacts}"
                  SelectedItem="{Binding SelectedContact, Mode=TwoWay}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Имя"
                                    Width="*"
                                    Binding="{Binding Name}"/>
                <DataGridTextColumn Header="Телефон"
                                    Width="*"
                                    Binding="{Binding Phone}"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>

