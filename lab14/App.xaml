<Application x:Class="lab14.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:lab14.Views"
             xmlns:vm="clr-namespace:lab14.ViewModels">
    <Application.Resources>
        <DataTemplate DataType="{x:Type vm:ContactsListViewModel}">
            <views:ContactsListView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ContactEditViewModel}">
            <views:ContactEditView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:AboutViewModel}">
            <views:AboutView />
        </DataTemplate>
    </Application.Resources>
</Application>
