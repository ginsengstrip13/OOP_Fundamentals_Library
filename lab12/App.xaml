<Application x:Class="lab12.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:lab12.Views"
             xmlns:vm="clr-namespace:lab12.ViewModels">
    <Application.Resources>
        <!--
            ViewModel-First: навигационный сервис меняет не UserControl, а объект ViewModel.
            ContentControl в Shell получает этот объект через Binding, а WPF ищет подходящий
            DataTemplate по типу объекта. Поэтому в коде навигации нет new ContactsListView().
        -->
        <DataTemplate DataType="{x:Type vm:ContactsListViewModel}">
            <!-- ContactsListView автоматически получает ContactsListViewModel как DataContext. -->
            <views:ContactsListView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ContactEditViewModel}">
            <!-- Экран редактирования выбирается, когда CurrentViewModel имеет тип ContactEditViewModel. -->
            <views:ContactEditView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:AboutViewModel}">
            <!-- Дополнительный экран нужен для демонстрации переключения между разными ViewModel. -->
            <views:AboutView />
        </DataTemplate>
    </Application.Resources>
</Application>
